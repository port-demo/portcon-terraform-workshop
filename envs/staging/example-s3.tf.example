# This is an example of a request file generated by the Port workflow.
# The actual file would be named: myapp-s3-bucket-req_abc123.tf

module "myapp_s3_bucket" {
  source = "../../modules/s3-bucket"

  bucket_name         = "myapp-user-uploads"
  versioning          = true
  block_public_access = true
  encryption          = "aws:kms"

  tags = {
    service          = "myapp"
    team             = "cloud-platform"
    environment      = "staging"
    data_sensitivity = "internal"
    infra_request_id = "req_abc123"
    managed_by       = "port"
  }
}
